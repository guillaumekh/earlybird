# Build settings. Copy to local.env, which is git-ignored, and fill it in.
# `make build` reads these from the environment; see README.md for ways to
# load this file.

# Wi-Fi network the Pico joins (2.4 GHz, WPA2). Either the values themselves,
# or secret references for a secrets manager, such as 1Password's
# op://Vault/Item/Section/field.
WIFI_SSID="my-network"
WIFI_PASSWORD="my-passphrase"

# OTLP/HTTP metrics endpoint of the OpenTelemetry Collector. Plain http only.
OTLP_URL=http://collector.example:4318/v1/metrics

# Bearer token for the collector. Leave it out to be asked for it at build time.
# OTLP_BEARER_TOKEN=
